# Copy this file to .env and adjust as needed.

# Port the server listens on
PORT=4000

# Which price data source to use:
#   tcgcsv - free, no API key, mirrors TCGPlayer's public pricing API (https://tcgcsv.com)
#   mock   - deterministic sample data, no network calls (good for local dev/demo)
PRICE_PROVIDER=tcgcsv

# Alert thresholds
ALERT_MIN_PRICE=4
ALERT_PCT_CHANGE=20
LOOKBACK_DAYS=30

# Which sets to track:
#   all-sets    - every set tcgcsv has for the category (default - currently
#                 ~90 groups: mainline boosters, starter/structure decks,
#                 release-event bonus packs, etc; a full refresh takes a
#                 couple of minutes and pulls several thousand cards)
#   recent-sets - only the N most recently *released* groups. Note tcgcsv
#                 treats a small 11-card starter deck the same as a full
#                 ~150-card booster, so a low N here can end up dominated by
#                 whatever small decks happened to ship most recently rather
#                 than covering more real boosters - raise RECENT_SET_COUNT
#                 if that happens, or just use all-sets.
#   named-sets  - only the sets listed in WATCHLIST_SET_NAMES
WATCHLIST_MODE=all-sets
RECENT_SET_COUNT=8
WATCHLIST_SET_NAMES=

# Cron schedule (UTC) for the automatic daily price refresh
REFRESH_CRON=0 13 * * *

# Optional: skip the "find One Piece category" lookup on tcgcsv.com by
# hardcoding its categoryId once you know it (speeds up startup slightly).
ONEPIECE_CATEGORY_ID=
